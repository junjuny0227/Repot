=== restore.ps1 ===
# Generated by Repot 0.2.0 on 2026-11-03 00:00 UTC
# Source: macOS -> Target: Windows
# Review this script before running it. Usage: powershell -ExecutionPolicy Bypass -File restore.ps1 [-Yes]
param([switch]$Yes)
$ErrorActionPreference = 'Continue'
$Dir = Split-Path -Parent $MyInvocation.MyCommand.Path
$Stamp = Get-Date -Format 'yyyyMMddHHmmss'
$script:Ok = @(); $script:Skipped = @(); $script:Failed = @()
function Test-Tool($Name) { [bool](Get-Command $Name -ErrorAction SilentlyContinue) }
function Add-Ok($Label) { $script:Ok += $Label; Write-Host "  ok: $Label" }
function Add-Skip($Label) { $script:Skipped += $Label; Write-Host "  skipped: $Label" }
function Add-Fail($Label) { $script:Failed += $Label; Write-Host "  FAILED: $Label" }
function Write-Missing($Name, $Url) { Write-Host "  $Name not found. Install it first: $Url" }
function Test-Admin { ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator) }
# Byte comparison instead of Get-FileHash: Get-FileHash lives in a script module that fails to
# load in Windows PowerShell 5.1 when it is started from PowerShell 7 (inherited PSModulePath).
function Test-SameFile($A, $B) {
  $x = [System.IO.File]::ReadAllBytes($A); $y = [System.IO.File]::ReadAllBytes($B)
  if ($x.Length -ne $y.Length) { return $false }
  for ($i = 0; $i -lt $x.Length; $i++) { if ($x[$i] -ne $y[$i]) { return $false } }
  return $true
}
function Copy-RepotFile($Src, $Dest) {
  $from = Join-Path $Dir (Join-Path 'files' $Src)
  if (-not (Test-Path $from)) { return 1 }
  if ((Test-Path $Dest) -and (Test-SameFile $from $Dest)) { return 2 }
  try {
    New-Item -ItemType Directory -Force -Path (Split-Path -Parent $Dest) | Out-Null
    if (Test-Path $Dest) { Copy-Item $Dest "$Dest.repot-backup-$Stamp" -ErrorAction Stop }
    Copy-Item $from $Dest -ErrorAction Stop
    return 0
  } catch { return 1 }
}

if ($env:OS -ne 'Windows_NT') { Write-Host 'This script targets Windows.'; exit 1 }
Write-Host 'This script will:'
Write-Host '  - winget install BurntSushi.ripgrep.MSVC'
Write-Host '  - winget install Git.Git'
Write-Host '  - winget install Mozilla.Firefox'
if (-not $Yes) { $answer = Read-Host 'Continue? [y/N]'; if ($answer -cne 'y' -and $answer -cne 'Y') { exit 0 } }

Write-Host '== Packages =='
if (Test-Tool 'winget') {
  # from brew: ripgrep
  & winget list --id 'BurntSushi.ripgrep.MSVC' --exact *> $null
  if ($LASTEXITCODE -eq 0) { Add-Skip 'winget install BurntSushi.ripgrep.MSVC' }
  else { & winget install --id 'BurntSushi.ripgrep.MSVC' --exact --accept-package-agreements --accept-source-agreements; if ($LASTEXITCODE -eq 0) { Add-Ok 'winget install BurntSushi.ripgrep.MSVC' } else { Add-Fail 'winget install BurntSushi.ripgrep.MSVC' } }
  # from brew: git
  & winget list --id 'Git.Git' --exact *> $null
  if ($LASTEXITCODE -eq 0) { Add-Skip 'winget install Git.Git' }
  else { & winget install --id 'Git.Git' --exact --accept-package-agreements --accept-source-agreements; if ($LASTEXITCODE -eq 0) { Add-Ok 'winget install Git.Git' } else { Add-Fail 'winget install Git.Git' } }
  # from brew: firefox
  & winget list --id 'Mozilla.Firefox' --exact *> $null
  if ($LASTEXITCODE -eq 0) { Add-Skip 'winget install Mozilla.Firefox' }
  else { & winget install --id 'Mozilla.Firefox' --exact --accept-package-agreements --accept-source-agreements; if ($LASTEXITCODE -eq 0) { Add-Ok 'winget install Mozilla.Firefox' } else { Add-Fail 'winget install Mozilla.Firefox' } }
} else {
  Write-Missing 'winget' 'https://learn.microsoft.com/windows/package-manager/winget/'
  Add-Skip 'winget install BurntSushi.ripgrep.MSVC'
  Add-Skip 'winget install Git.Git'
  Add-Skip 'winget install Mozilla.Firefox'
}

Write-Host 'Summary'
Write-Host 'OK:'; $script:Ok | ForEach-Object { Write-Host "  - $_" }
Write-Host 'Skipped:'; $script:Skipped | ForEach-Object { Write-Host "  - $_" }
Write-Host 'Failed:'; $script:Failed | ForEach-Object { Write-Host "  - $_" }
if ($script:Failed.Count -gt 0) { exit 1 } else { exit 0 }

=== README.md ===
# Repot export

Review the restore script before running it. Install the required package managers first.

## Mapped packages

Names come from the embedded package map. Verify them before restoring.

- brew: ripgrep -> winget: BurntSushi.ripgrep.MSVC
- brew: git -> winget: Git.Git
- brew: firefox -> winget: Mozilla.Firefox
