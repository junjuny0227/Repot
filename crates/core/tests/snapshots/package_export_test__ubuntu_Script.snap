=== restore.sh ===
#!/usr/bin/env bash
# Generated by Repot 0.2.0 on 2026-11-03 00:00 UTC
# Source: macOS -> Target: Linux (Debian/Ubuntu)
# Review this script before running it. Usage: ./restore.sh [--yes]

DIR="$(cd "$(dirname "$0")" && pwd)"
STAMP="$(date +%Y%m%d%H%M%S)"
PREFLIGHT_MISSING=0; OK_LIST=""; DONE_LIST=""; NOT_DONE_LIST=""; FAIL_LIST=""; TOOLS_LIST=""; FAILED=0
have() { command -v "$1" >/dev/null 2>&1; }
record_ok()   { OK_LIST="$OK_LIST  - $1
"; echo "  ok: $1"; }
# Already installed or identical: nothing to do.
record_done() { DONE_LIST="$DONE_LIST  - $1
"; echo "  already done: $1"; }
# Not attempted; $2 says why and what the user can do about it.
record_not_done() { NOT_DONE_LIST="$NOT_DONE_LIST  - $1 ($2)
"; echo "  not done: $1 ($2)"; }
record_fail() { FAIL_LIST="$FAIL_LIST  - $1
"; FAILED=1; echo "  FAILED: $1"; }
# Preflight: report whether a tool is here before anything runs.
check_tool() {
  if eval "$2"; then echo "  $1: found"
  else echo "  $1: not found yet. Install it from $3"; PREFLIGHT_MISSING=1; fi
}
missing() {
  echo "  $1 not found. Install it first: $2"
  case "$TOOLS_LIST" in *"  $1: $2
"*) ;; *) TOOLS_LIST="$TOOLS_LIST  $1: $2
" ;; esac
}
copy_file() {
  src="$DIR/files/$1"; dest="$2"
  if [ -f "$dest" ] && cmp -s "$src" "$dest"; then return 2; fi
  [ -f "$src" ] || return 1
  mkdir -p "$(dirname "$dest")" || return 1
  if [ -e "$dest" ]; then cp -p "$dest" "$dest.repot-backup-$STAMP" || return 1; fi
  cp "$src" "$dest"
}

if [ "$(uname -s)" != 'Linux' ]; then echo 'This script targets a different OS.'; exit 1; fi
echo 'This script will:'
printf '%s\n' '  - apt-get install ripgrep'
printf '%s\n' '  - apt-get install git'
echo 'Tools this script uses:'
check_tool 'apt-get' 'have '\''apt-get'\''' ''
if [ "$PREFLIGHT_MISSING" = 1 ]; then
  echo 'Steps that need a missing tool will be listed under "Not done". An earlier step may install some of them (for example Node.js from Homebrew); otherwise install them and run this script again.'
fi
if [ "${1:-}" != '--yes' ]; then
  printf 'Continue? [y/N] '
  read -r answer
  case "$answer" in y|Y) ;; *) exit 0 ;; esac
fi

echo '== Packages =='
if have 'apt-get'; then
  # from brew: ripgrep
  if dpkg -s 'ripgrep' >/dev/null 2>&1; then record_done 'apt-get install ripgrep'
  elif sudo apt-get install -y 'ripgrep'; then record_ok 'apt-get install ripgrep'
  else record_fail 'apt-get install ripgrep'; fi
  # from brew: git
  if dpkg -s 'git' >/dev/null 2>&1; then record_done 'apt-get install git'
  elif sudo apt-get install -y 'git'; then record_ok 'apt-get install git'
  else record_fail 'apt-get install git'; fi
else
  missing 'apt-get' ''
  record_not_done 'apt-get install ripgrep' 'apt-get not found'
  record_not_done 'apt-get install git' 'apt-get not found'
fi

printf '\nSummary\nOK:\n%sAlready done:\n%sNot done:\n%s' "$OK_LIST" "$DONE_LIST" "$NOT_DONE_LIST"
if [ -n "$TOOLS_LIST" ]; then printf 'To finish these, install the missing tools and run this script again:\n%s' "$TOOLS_LIST"; fi
printf 'Failed:\n%s' "$FAIL_LIST"
exit $FAILED

=== README.md ===
# Repot export

Review the restore script before running it. Install the required package managers first.

## Mapped packages

Names come from the embedded package map. Verify them before restoring.

- brew: ripgrep -> apt: ripgrep
- brew: git -> apt: git
