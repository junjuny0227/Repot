=== restore.sh ===
#!/usr/bin/env bash
# Generated by Repot 0.2.0 on 2026-11-03 00:00 UTC
# Source: macOS -> Target: Linux (Fedora)
# Review this script before running it. Usage: ./restore.sh [--yes]

DIR="$(cd "$(dirname "$0")" && pwd)"
STAMP="$(date +%Y%m%d%H%M%S)"
OK_LIST=""; SKIP_LIST=""; FAIL_LIST=""; FAILED=0
have() { command -v "$1" >/dev/null 2>&1; }
record_ok()   { OK_LIST="$OK_LIST  - $1
"; echo "  ok: $1"; }
record_skip() { SKIP_LIST="$SKIP_LIST  - $1
"; echo "  skipped: $1"; }
record_fail() { FAIL_LIST="$FAIL_LIST  - $1
"; FAILED=1; echo "  FAILED: $1"; }
missing() { echo "  $1 not found. Install it first: $2"; }
copy_file() {
  src="$DIR/files/$1"; dest="$2"
  if [ -f "$dest" ] && cmp -s "$src" "$dest"; then return 2; fi
  [ -f "$src" ] || return 1
  mkdir -p "$(dirname "$dest")" || return 1
  if [ -e "$dest" ]; then cp -p "$dest" "$dest.repot-backup-$STAMP" || return 1; fi
  cp "$src" "$dest"
}

if [ "$(uname -s)" != 'Linux' ]; then echo 'This script targets a different OS.'; exit 1; fi
echo 'This script will:'
printf '%s\n' '  - dnf install ripgrep'
printf '%s\n' '  - dnf install git'
printf '%s\n' '  - dnf install firefox'
if [ "${1:-}" != '--yes' ]; then
  printf 'Continue? [y/N] '
  read -r answer
  case "$answer" in y|Y) ;; *) exit 0 ;; esac
fi

echo '== Packages =='
if have 'dnf'; then
  # from brew: ripgrep
  if rpm -q 'ripgrep' >/dev/null 2>&1; then record_skip 'dnf install ripgrep'
  elif sudo dnf install -y 'ripgrep'; then record_ok 'dnf install ripgrep'
  else record_fail 'dnf install ripgrep'; fi
  # from brew: git
  if rpm -q 'git' >/dev/null 2>&1; then record_skip 'dnf install git'
  elif sudo dnf install -y 'git'; then record_ok 'dnf install git'
  else record_fail 'dnf install git'; fi
  # from brew: firefox
  if rpm -q 'firefox' >/dev/null 2>&1; then record_skip 'dnf install firefox'
  elif sudo dnf install -y 'firefox'; then record_ok 'dnf install firefox'
  else record_fail 'dnf install firefox'; fi
else
  missing 'dnf' ''
  record_skip 'dnf install ripgrep'
  record_skip 'dnf install git'
  record_skip 'dnf install firefox'
fi

printf '\nSummary\nOK:\n%sSkipped:\n%sFailed:\n%s' "$OK_LIST" "$SKIP_LIST" "$FAIL_LIST"
exit $FAILED

=== README.md ===
# Repot export

Review the restore script before running it. Install the required package managers first.

## Mapped packages

Names come from the embedded package map. Verify them before restoring.

- brew: ripgrep -> dnf: ripgrep
- brew: git -> dnf: git
- brew: firefox -> dnf: firefox
