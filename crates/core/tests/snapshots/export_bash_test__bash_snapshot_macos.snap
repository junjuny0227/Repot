---
#!/usr/bin/env bash
# Generated by Repot 0.1.0 on 2026-11-02 10:00 UTC
# Source: macOS -> Target: macOS
# Review this script before running it. Usage: ./restore.sh [--yes]

DIR="$(cd "$(dirname "$0")" && pwd)"
STAMP="$(date +%Y%m%d%H%M%S)"
OK_LIST=""; DONE_LIST=""; NOT_DONE_LIST=""; FAIL_LIST=""; TOOLS_LIST=""; FAILED=0
have() { command -v "$1" >/dev/null 2>&1; }
record_ok()   { OK_LIST="$OK_LIST  - $1
"; echo "  ok: $1"; }
# Already installed or identical: nothing to do.
record_done() { DONE_LIST="$DONE_LIST  - $1
"; echo "  already done: $1"; }
# Not attempted; $2 says why and what the user can do about it.
record_not_done() { NOT_DONE_LIST="$NOT_DONE_LIST  - $1 ($2)
"; echo "  not done: $1 ($2)"; }
record_fail() { FAIL_LIST="$FAIL_LIST  - $1
"; FAILED=1; echo "  FAILED: $1"; }
missing() {
  echo "  $1 not found. Install it first: $2"
  case "$TOOLS_LIST" in *"  $1: $2
"*) ;; *) TOOLS_LIST="$TOOLS_LIST  $1: $2
" ;; esac
}
copy_file() {
  src="$DIR/files/$1"; dest="$2"
  if [ -f "$dest" ] && cmp -s "$src" "$dest"; then return 2; fi
  [ -f "$src" ] || return 1
  mkdir -p "$(dirname "$dest")" || return 1
  if [ -e "$dest" ]; then cp -p "$dest" "$dest.repot-backup-$STAMP" || return 1; fi
  cp "$src" "$dest"
}

if [ "$(uname -s)" != 'Darwin' ]; then echo 'This script targets a different OS.'; exit 1; fi
echo 'This script will:'
printf '%s\n' '  - brew tap oven-sh/bun'
printf '%s\n' '  - brew install jq'
printf '%s\n' '  - brew install --cask visual-studio-code'
printf '%s\n' '  - nvm install node 20.11.0'
printf '%s\n' '  - npm install -g typescript'
printf '%s\n' '  - code --install-extension esbenp.prettier-vscode'
printf '%s\n' '  - copy ~/.zshrc'
printf '%s\n' '  - copy ~/it'\''s.json'
printf '%s\n' '  - git clone https://github.com/zsh-users/zsh-autosuggestions'
if [ "${1:-}" != '--yes' ]; then
  printf 'Continue? [y/N] '
  read -r answer
  case "$answer" in y|Y) ;; *) exit 0 ;; esac
fi

echo '== Packages =='
if have 'brew'; then
  if brew tap | grep -qx 'oven-sh/bun' >/dev/null 2>&1; then record_done 'brew tap oven-sh/bun'
  elif brew tap 'oven-sh/bun'; then record_ok 'brew tap oven-sh/bun'
  else record_fail 'brew tap oven-sh/bun'; fi
  if brew list --formula 'jq' >/dev/null 2>&1; then record_done 'brew install jq'
  elif brew install 'jq'; then record_ok 'brew install jq'
  else record_fail 'brew install jq'; fi
  if brew list --cask 'visual-studio-code' >/dev/null 2>&1; then record_done 'brew install --cask visual-studio-code'
  elif brew install --cask 'visual-studio-code'; then record_ok 'brew install --cask visual-studio-code'
  else record_fail 'brew install --cask visual-studio-code'; fi
else
  missing 'brew' 'https://brew.sh'
  record_not_done 'brew tap oven-sh/bun' 'brew not found'
  record_not_done 'brew install jq' 'brew not found'
  record_not_done 'brew install --cask visual-studio-code' 'brew not found'
fi

echo '== Runtimes =='
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"; [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
if have 'nvm'; then
  if nvm ls '20.11.0' >/dev/null 2>&1; then record_done 'nvm install node 20.11.0'
  elif nvm install '20.11.0' && nvm alias default '20.11.0'; then record_ok 'nvm install node 20.11.0'
  else record_fail 'nvm install node 20.11.0'; fi
else
  missing 'nvm' 'https://github.com/nvm-sh/nvm'
  record_not_done 'nvm install node 20.11.0' 'nvm not found'
fi

echo '== Global packages =='
if have 'npm'; then
  if npm ls -g --depth=0 'typescript' >/dev/null 2>&1; then record_done 'npm install -g typescript'
  elif npm install -g 'typescript'; then record_ok 'npm install -g typescript'
  else record_fail 'npm install -g typescript'; fi
else
  missing 'npm' 'https://nodejs.org'
  record_not_done 'npm install -g typescript' 'npm not found'
fi

echo '== Extensions =='
if have 'code'; then
  if code --list-extensions | grep -qix 'esbenp.prettier-vscode' >/dev/null 2>&1; then record_done 'code --install-extension esbenp.prettier-vscode'
  elif code --install-extension 'esbenp.prettier-vscode'; then record_ok 'code --install-extension esbenp.prettier-vscode'
  else record_fail 'code --install-extension esbenp.prettier-vscode'; fi
else
  missing 'code' 'https://code.visualstudio.com/docs/setup/setup-overview'
  record_not_done 'code --install-extension esbenp.prettier-vscode' 'code not found'
fi

echo '== Files =='
copy_file 'home/.zshrc' "$HOME/"'.zshrc'; rc=$?
if [ $rc -eq 0 ]; then record_ok 'copy ~/.zshrc'
elif [ $rc -eq 2 ]; then record_done 'copy ~/.zshrc'
else record_fail 'copy ~/.zshrc'; fi
copy_file 'home/it'\''s.json' "$HOME/"'it'\''s.json'; rc=$?
if [ $rc -eq 0 ]; then record_ok 'copy ~/it'\''s.json'
elif [ $rc -eq 2 ]; then record_done 'copy ~/it'\''s.json'
else record_fail 'copy ~/it'\''s.json'; fi
if have 'git' && [ -d "$HOME/.oh-my-zsh" ]; then
  if [ -d "$HOME/"'.oh-my-zsh/custom/plugins/zsh-autosuggestions' ] >/dev/null 2>&1; then record_done 'git clone https://github.com/zsh-users/zsh-autosuggestions'
  elif git clone 'https://github.com/zsh-users/zsh-autosuggestions' "$HOME/"'.oh-my-zsh/custom/plugins/zsh-autosuggestions'; then record_ok 'git clone https://github.com/zsh-users/zsh-autosuggestions'
  else record_fail 'git clone https://github.com/zsh-users/zsh-autosuggestions'; fi
else
  missing 'oh-my-zsh' 'https://ohmyz.sh'
  record_not_done 'git clone https://github.com/zsh-users/zsh-autosuggestions' 'oh-my-zsh not found'
fi

printf '\nSummary\nOK:\n%sAlready done:\n%sNot done:\n%s' "$OK_LIST" "$DONE_LIST" "$NOT_DONE_LIST"
if [ -n "$TOOLS_LIST" ]; then printf 'To finish these, install the missing tools and run this script again:\n%s' "$TOOLS_LIST"; fi
printf 'Failed:\n%s' "$FAIL_LIST"
echo 'Fill in these masked secrets:'
printf '%s\n' '  - files/home/.zshrc line 3 (GITHUB_TOKEN)'
echo 'Notes:'
printf '%s\n' 'files/home/.gitconfig line 5: credential.helper was commented out because it is OS-specific.'
exit $FAILED
